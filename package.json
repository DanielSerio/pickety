{
  "name": "pickety",
  "displayName": "pickety",
  "description": "a high-performance architectural enforcement engine for TypeScript projects",
  "author": {
    "name": "Dan Serio"
  },
  "version": "0.0.1",
  "publisher": "danserio",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danserio/pickety.git"
  },
  "keywords": [
    "architecture",
    "typescript",
    "SOLID",
    "boundaries",
    "mermaid"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:pickety.json"
  ],
  "main": "./out/extension.js",
  "bin": {
    "pickety": "./out/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "pickety.refresh",
        "title": "Pickety: Refresh Configuration",
        "category": "Pickety"
      },
      {
        "command": "pickety.generateDiagram",
        "title": "Pickety: Generate Boundary Diagram",
        "category": "Pickety"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "pickety.json",
        "url": "./src/pickety.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --main-fields=module,main --minify",
    "build:cli": "esbuild ./src/cli.ts --bundle --outfile=out/cli.js --format=cjs --platform=node --main-fields=module,main --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --main-fields=module,main --watch",
    "type-check": "tsc -p ./ --noEmit",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:core": "npm run compile && mocha --ui tdd out/test/core/**/*.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.2"
  }
}