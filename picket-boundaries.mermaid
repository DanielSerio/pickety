graph LR

  %% Module definitions
  %% core: src/core/*
  %% extension: src/{extension,commandRegistry}.ts
  %% infra: src/{documentValidator,statusBar,diagnostics,navigation,codeActions,healthPanel,impactCodeLens,diagnosticManager,telemetry}.ts
  %% shared: src/{utils,types}.ts
  %% commands: src/commands/*.ts

  subgraph rule_0 ["ALLOW: rule#lsqb;0#rsqb; (error)"]
    r0_from["core"]
    r0_to["core"]
    r0_from --> r0_to
  end

  subgraph rule_1 ["DENY: rule#lsqb;1#rsqb; (error)"]
    r1_from["core"]
    r1_to["infra"]
    r1_from -.-> |"Core logic must remain platform-agnostic. No VS Code dependencies in src/core."| r1_to
  end

  subgraph rule_2 ["DENY: rule#lsqb;2#rsqb; (error)"]
    r2_from["core"]
    r2_to["services"]
    r2_from -.-> |"Core logic must remain platform-agnostic. No VS Code dependencies in src/core."| r2_to
  end

  subgraph rule_3 ["DENY: rule#lsqb;3#rsqb; (error)"]
    r3_from["infra"]
    r3_to["services"]
    r3_from -.-> |"Infrastructure components should not depend on service orchestration."| r3_to
  end

  subgraph rule_4 ["ALLOW: rule#lsqb;4#rsqb; (error)"]
    r4_from["extension"]
    r4_to["services"]
    r4_from --> r4_to
  end

  subgraph rule_5 ["ALLOW: rule#lsqb;5#rsqb; (error)"]
    r5_from["extension"]
    r5_to["infra"]
    r5_from --> r5_to
  end

  subgraph rule_6 ["ALLOW: rule#lsqb;6#rsqb; (error)"]
