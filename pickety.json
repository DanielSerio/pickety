{
  "$schema": "./resources/pickety.schema.json",
  "modules": {
    "core": "src/core/*",
    "extension": "src/extension.ts",
    "controller": "src/controller.ts",
    "cli": "src/cli.ts",
    "vscode-impl": "src/{statusBar,diagnostics,navigation,codeActions,healthPanel,impactCodeLens,diagnosticManager,telemetry}.ts",
    "shared": "src/{utils,types}.ts",
    "commands": "src/commands/*.ts"
  },
  "rules": {
    "module-boundaries": {
      "severity": "error",
      "rules": [
        {
          "importer": "core",
          "imports": "core",
          "allow": true
        },
        {
          "importer": "core",
          "imports": "vscode-impl",
          "allow": false,
          "message": "Core logic must remain platform-agnostic. No VS Code dependencies in src/core."
        },
        {
          "importer": "extension",
          "imports": "controller",
          "allow": true
        },
        {
          "importer": "controller",
          "imports": "core",
          "allow": true
        },
        {
          "importer": "cli",
          "imports": "core",
          "allow": true
        }
      ]
    }
  },
  "boundary-diagrams": true
}