{
  "$schema": "./resources/pickety.schema.json",
  "modules": {
    "core": "src/core/*",
    "commands": "src/commands/*.ts",
    "cli": "src/cli/*.ts",
    "services": "src/services/*.ts",
    "vscode": "src/vscode/*.ts",
    "shared": "src/shared/*.ts",
    "extension": "src/extension/*.ts"
  },
  "rules": {
    "module-boundaries": {
      "severity": "error",
      "rules": [
        {
          "importer": "core",
          "imports": "core",
          "allow": true
        },
        {
          "importer": "core",
          "imports": "vscode",
          "allow": false,
          "message": "Core logic must remain platform-agnostic. No VS Code dependencies in src/core."
        },
        {
          "importer": "core",
          "imports": "services",
          "allow": false,
          "message": "Core logic must remain platform-agnostic. No VS Code dependencies in src/core."
        },
        {
          "importer": "vscode",
          "imports": "services",
          "allow": false,
          "message": "Infrastructure components should not depend on service orchestration."
        },
        {
          "importer": "extension",
          "imports": "services",
          "allow": true
        },
        {
          "importer": "extension",
          "imports": "vscode",
          "allow": true
        },
        {
          "importer": "cli",
          "imports": "core",
          "allow": true
        }
      ]
    }
  },
  "boundary-diagrams": true
}
