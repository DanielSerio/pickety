{
  "$schema": "./resources/pickety.schema.json",
  "modules": {
    "core": "src/core/*",
    "extension": "src/{extension,commandRegistry}.ts",
    "infra": "src/{documentValidator,statusBar,diagnostics,navigation,codeActions,healthPanel,impactCodeLens,diagnosticManager,telemetry}.ts",
    "shared": "src/{utils,types}.ts",
    "commands": "src/commands/*.ts"
  },
  "rules": {
    "module-boundaries": {
      "severity": "error",
      "rules": [
        {
          "importer": "core",
          "imports": "core",
          "allow": true
        },
        {
          "importer": "core",
          "imports": "infra",
          "allow": false,
          "message": "Core logic must remain platform-agnostic. No VS Code dependencies in src/core."
        },
        {
          "importer": "core",
          "imports": "services",
          "allow": false,
          "message": "Core logic must remain platform-agnostic. No VS Code dependencies in src/core."
        },
        {
          "importer": "infra",
          "imports": "services",
          "allow": false,
          "message": "Infrastructure components should not depend on service orchestration."
        },
        {
          "importer": "extension",
          "imports": "services",
          "allow": true
        },
        {
          "importer": "extension",
          "imports": "infra",
          "allow": true
        },
        {
          "importer": "cli",
          "imports": "core",
          "allow": true
        }
      ]
    }
  },
  "boundary-diagrams": true
}